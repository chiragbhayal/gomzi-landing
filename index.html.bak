<!-- SCRIPT: RAG CRM INQUIRY INTEGRATION -->
<script>

// Client-side Price Table Category Filter & Search
function filterPriceTable(category, buttonElem) {
  var buttons = document.querySelectorAll('.cat-pill-btn');
  buttons.forEach(function(b) { b.classList.remove('active'); });
  if (buttonElem) buttonElem.classList.add('active');

  var rows = document.querySelectorAll('#price_table_body tr');
  rows.forEach(function(row) {
    var cat = row.getAttribute('data-cat');
    if (category === 'all' || cat === category) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });

  var mobCards = document.querySelectorAll('#mobile_price_cards .mob-price-card');
  mobCards.forEach(function(card) {
    var cat = card.getAttribute('data-cat');
    if (category === 'all' || cat === category) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });
}

function searchPriceTable(keyword) {
  var q = (keyword || '').toLowerCase().trim();
  var rows = document.querySelectorAll('#price_table_body tr');
  rows.forEach(function(row) {
    var text = (row.textContent || '').toLowerCase();
    if (!q || text.indexOf(q) !== -1) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });

  var mobCards = document.querySelectorAll('#mobile_price_cards .mob-price-card');
  mobCards.forEach(function(card) {
    var text = (card.textContent || '').toLowerCase();
    if (!q || text.indexOf(q) !== -1) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });
}

function selectPackage(packageName) {
  var selectElem = document.getElementById('inq_pack');
  if (selectElem && packageName) {
    for (var i = 0; i < selectElem.options.length; i++) {
      if (selectElem.options[i].value.indexOf(packageName) !== -1 || packageName.indexOf(selectElem.options[i].value) !== -1) {
        selectElem.selectedIndex = i;
        break;
      }
    }
  }
  var inquireSection = document.getElementById('inquire');
  if (inquireSection) {
    inquireSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}

function resetInquiryForm() {
  var form = document.getElementById('gomzi_inquiry_form');
  var successBox = document.getElementById('inq_success_box');
  var errorBox = document.getElementById('inq_error_box');
  if (form) {
    form.reset();
    form.style.display = 'block';
  }
  if (successBox) successBox.style.display = 'none';
  if (errorBox) errorBox.style.display = 'none';
}

async function handleInquirySubmit(event) {
  event.preventDefault();
  
  var name = document.getElementById('inq_name').value.trim();
  var mobile = document.getElementById('inq_mobile').value.trim();
  var email = document.getElementById('inq_email').value.trim();
  var branch = document.getElementById('inq_branch').value;
  var pack = document.getElementById('inq_pack').value;
  var userMessage = document.getElementById('inq_message').value.trim();
  
  var errorBox = document.getElementById('inq_error_box');
  var submitBtn = document.getElementById('inq_submit_btn');
  
  errorBox.style.display = 'none';
  errorBox.textContent = '';
  
  // Validation
  if (!name || name.length < 2) {
    errorBox.textContent = 'Please enter your full name.';
    errorBox.style.display = 'block';
    return;
  }
  
  // Clean phone number (extract digits)
  var cleanPhone = mobile.replace(/[^0-9]/g, '');
  if (cleanPhone.length > 10 && cleanPhone.startsWith('91')) {
    cleanPhone = cleanPhone.slice(2);
  }
  if (cleanPhone.length < 10) {
    errorBox.textContent = 'Please enter a valid 10-digit mobile number.';
    errorBox.style.display = 'block';
    return;
  }
  
  var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!email || !emailRegex.test(email)) {
    errorBox.textContent = 'Please enter a valid email address.';
    errorBox.style.display = 'block';
    return;
  }
  
  // Loading state
  submitBtn.disabled = true;
  submitBtn.innerHTML = '<span class="inq-spinner"></span><span>CONNECTING TO CRM...</span>';
  
  var subject = 'Offer Inquiry - ' + branch + ' - ' + pack;
  var message = userMessage 
    ? userMessage + '\n\n[Package Interest: ' + pack + ' | Gym Branch: ' + branch + ']'
    : 'Customer inquired to claim offer: ' + pack + ' at Fitness with Gomzi (' + branch + ' branch).';
  
  var sourceUrl = (window.location.href && window.location.href.startsWith('http')) 
    ? window.location.href 
    : 'https://ragnutrition.in/gomzi-landing';
    
  var payload = {
    name: name,
    email: email,
    mobile: cleanPhone,
    subject: subject,
    message: message,
    source: sourceUrl,
    details: {
      campaign: 'Buy Supplements Get Gym Free (Diwali Launch)',
      branch: branch,
      package_interest: pack,
      landing_page: 'GOMZI Offer Landing',
      page_url: sourceUrl,
      submitted_at: new Date().toISOString()
    }
  };
  
  var apiBase = (window.GOMZI_API_URL || 'https://api.ragnutrition.in').replace(/\/+$/, '');
  var endpoint = apiBase + '/public/v1/contact-inquiry';
  
  try {
    var response = await fetch(endpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(payload)
    });
    
    var data = await response.json().catch(function() { return {}; });
    
    if (response.ok && (data.status === 200 || data.response === 'Success' || data.response === 'OK' || data.data)) {
      // Success
      document.getElementById('gomzi_inquiry_form').style.display = 'none';
      var successBox = document.getElementById('inq_success_box');
      document.getElementById('inq_success_msg').textContent = 
        'Thank you, ' + name + '! Your inquiry for the ' + pack + ' at ' + branch + ' branch has been registered in the RAG CRM. Our team will contact you shortly to activate your free 1-month gym membership.';
      
      // WhatsApp prefill
      var waText = encodeURIComponent('Hi GOMZI! I just submitted an offer inquiry on your website.\nName: ' + name + '\nBranch: ' + branch + '\nOffer: ' + pack + '\nPhone: ' + cleanPhone);
      document.getElementById('inq_whatsapp_direct').href = 'https://wa.me/919875270200?text=' + waText;
      
      successBox.style.display = 'block';
      successBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      var errMsg = data.message || 'Unable to submit your inquiry at this moment. Please call or WhatsApp us at +91 98752 70200.';
      errorBox.textContent = errMsg;
      errorBox.style.display = 'block';
    }
  } catch (err) {
    console.error('Inquiry submission error:', err);
    errorBox.textContent = 'Network error while submitting your inquiry. Please check your internet connection or WhatsApp us directly at +91 98752 70200.';
    errorBox.style.display = 'block';
  } finally {
    submitBtn.disabled = false;
    submitBtn.innerHTML = '<span>CLAIM YOUR FREE GYM PASS</span><span style="font-size: 28px; line-height: 1">&rarr;</span>';
  }
}
</script>

