<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GOMZI Supplements | Buy Supplements, Get the Gym Free | Surat</title>
<meta name="description" content="Buy any GOMZI supplement worth ₹999 or more and get 1 month gym access free at Fitness with Gomzi – Vesu, Katargam and Adajan, Surat.">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Poppins:wght@400;500;600&amp;display=swap">
<style>
body{margin:0;background:#FFFFFF}
html{scroll-behavior:smooth}
img{max-width:100%}
a:focus-visible{outline:2px solid #5A2D1A;outline-offset:3px}
@media (max-width:640px){h1{font-size:56px !important}h2{font-size:42px !important}}
a{color:#141414}a:hover{color:#5A2D1A}

/* INQUIRY FORM STYLES */
.inq-input {
  width: 100%;
  box-sizing: border-box;
  padding: 14px 16px;
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 15px;
  color: #141414;
  background: #FFFFFF;
  border: 1px solid #D6D6D2;
  border-radius: 6px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.inq-input:focus {
  border-color: #5A2D1A;
  box-shadow: 0 0 0 3px rgba(90, 45, 26, 0.12);
}
.inq-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #141414;
  margin-bottom: 6px;
}
.inq-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
@media (max-width: 768px) {
  .inq-grid {
    grid-template-columns: 1fr;
  }
}
.inq-btn {
  background: #141414;
  color: #FFFFFF;
  font-family: 'Bebas Neue', Impact, sans-serif;
  font-size: 26px;
  letter-spacing: 1px;
  padding: 16px 32px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  transition: background 0.2s, transform 0.1s;
}
.inq-btn:hover:not(:disabled) {
  background: #5A2D1A;
}
.inq-btn:active:not(:disabled) {
  transform: translateY(1px);
}
.inq-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}
.inq-spinner {
  display: inline-block;
  width: 22px;
  height: 22px;
  border: 3px solid rgba(255,255,255,0.3);
  border-radius: 50%;
  border-top-color: #FFFFFF;
  animation: inqSpin 0.8s linear infinite;
}
@keyframes inqSpin {
  to { transform: rotate(360deg); }
}
.claim-pack-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #141414;
  color: #FFFFFF;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 20px;
  border-radius: 6px;
  margin-top: 14px;
  cursor: pointer;
  border: none;
  transition: background 0.2s;
}
.claim-pack-btn:hover {
  background: #5A2D1A;
  color: #FFFFFF;
}


/* ==========================================================================
   PRICES & OFFERS MODERN DESIGN SYSTEM
   ========================================================================== */
.price-section-wrap {
  max-width: 1180px;
  margin: 0 auto;
  padding: 80px 24px;
}
.offer-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 32px;
  margin-bottom: 32px;
}
@media (max-width: 900px) {
  .offer-cards-grid {
    grid-template-columns: 1fr;
  }
}
.offer-feature-card {
  background: #FFFFFF;
  border: 1px solid #E6E6E3;
  border-radius: 10px;
  padding: 24px;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  display: flex;
  flex-direction: column;
}
.offer-feature-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(0,0,0,0.06);
  border-color: #5A2D1A;
}
.offer-card-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #5A2D1A;
  background: #F8EFEA;
  padding: 4px 10px;
  border-radius: 20px;
  width: fit-content;
  margin-bottom: 14px;
}
.offer-card-tag.hot {
  color: #B91C1C;
  background: #FEE2E2;
}
.offer-card-tag.highlight {
  color: #15803D;
  background: #DCFCE7;
}
.offer-card-title {
  margin: 0 0 8px;
  font-family: 'Bebas Neue', Impact, sans-serif;
  font-size: 32px;
  line-height: 1.05;
  color: #141414;
}
.offer-card-desc {
  margin: 0 0 16px;
  font-size: 14px;
  line-height: 1.5;
  color: #555555;
  flex-grow: 1;
}
.offer-card-value {
  background: #141414;
  color: #FFFFFF;
  border-radius: 6px;
  padding: 10px 14px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.offer-card-btn {
  margin-top: 12px;
  background: #5A2D1A;
  color: #FFFFFF;
  border: none;
  border-radius: 6px;
  padding: 10px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  text-align: center;
  transition: background 0.2s;
  width: 100%;
}
.offer-card-btn:hover {
  background: #141414;
}

/* DIWALI BANNER */
.diwali-ribbon-bar {
  background: linear-gradient(90deg, #141414 0%, #3D1F12 50%, #141414 100%);
  color: #FFFFFF;
  border-radius: 8px;
  padding: 16px 24px;
  margin-bottom: 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  border-left: 4px solid #F59E0B;
}

/* FILTERS & SEARCH BAR */
.price-controls-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
}
.price-category-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.cat-pill-btn {
  background: #F4F4F2;
  border: 1px solid #E6E6E3;
  color: #555555;
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.2s;
}
.cat-pill-btn:hover {
  background: #EAEAE6;
  color: #141414;
}
.cat-pill-btn.active {
  background: #141414;
  border-color: #141414;
  color: #FFFFFF;
}
.price-search-input {
  padding: 9px 16px;
  border: 1px solid #D6D6D2;
  border-radius: 20px;
  font-family: 'Poppins', Arial, sans-serif;
  font-size: 13px;
  color: #141414;
  outline: none;
  min-width: 220px;
  transition: border-color 0.2s;
}
.price-search-input:focus {
  border-color: #5A2D1A;
}

/* TABLE STYLING */
.price-table-card {
  background: #FFFFFF;
  border: 1px solid #E6E6E3;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 18px rgba(0,0,0,0.03);
}
.custom-price-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14.5px;
  text-align: left;
}
.custom-price-table th {
  background: #F8F8F6;
  padding: 16px 20px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: #555555;
  border-bottom: 2px solid #E6E6E3;
}
.custom-price-table td {
  padding: 18px 20px;
  vertical-align: middle;
  border-bottom: 1px solid #EEEEEC;
  transition: background 0.15s;
}
.custom-price-table tr:hover td {
  background: #FBFBFA;
}
.prod-cell {
  display: flex;
  align-items: center;
  gap: 14px;
}
.prod-thumb {
  width: 44px;
  height: 44px;
  min-width: 44px;
  border-radius: 6px;
  object-fit: cover;
  background: #F4F4F2;
  border: 1px solid #E6E6E3;
}
.prod-meta {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.prod-title {
  font-weight: 600;
  color: #141414;
  font-size: 15px;
  line-height: 1.2;
}
.prod-subtitle {
  font-size: 12px;
  color: #71717A;
}
.prod-tag {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 4px;
  width: fit-content;
  margin-top: 2px;
}
.prod-tag.gold {
  background: #FEF3C7;
  color: #92400E;
}
.prod-tag.red {
  background: #FEE2E2;
  color: #991B1B;
}
.prod-tag.blue {
  background: #DBEAFE;
  color: #1E40AF;
}

.size-pill {
  display: inline-block;
  background: #F4F4F2;
  color: #374151;
  font-size: 12.5px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 4px;
  white-space: nowrap;
}
.price-val {
  font-weight: 700;
  color: #141414;
  font-size: 16px;
  white-space: nowrap;
}

/* OFFER BADGES IN TABLE */
.badge-offer-gym {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #ECFDF5;
  color: #065F46;
  border: 1px solid #A7F3D0;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 6px;
  margin-bottom: 4px;
  white-space: nowrap;
}
.badge-offer-gift {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #FFFBEB;
  color: #92400E;
  border: 1px solid #FDE68A;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 6px;
  white-space: nowrap;
}

.table-claim-btn {
  background: #141414;
  color: #FFFFFF;
  border: none;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  padding: 8px 16px;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.table-claim-btn:hover {
  background: #5A2D1A;
  transform: translateY(-1px);
}

/* MOBILE CARD VIEW (Responsive) */
.mobile-price-cards {
  display: none;
  flex-direction: column;
  gap: 16px;
}
@media (max-width: 768px) {
  .price-table-desktop {
    display: none;
  }
  .mobile-price-cards {
    display: flex;
  }
}
.mob-price-card {
  background: #FFFFFF;
  border: 1px solid #E6E6E3;
  border-radius: 10px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.03);
}
.mob-price-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.mob-price-card-offers {
  display: flex;
  flex-direction: column;
  gap: 6px;
  background: #F8F8F6;
  padding: 10px 12px;
  border-radius: 6px;
}

</style>
</head>
